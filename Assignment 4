
from datetime import datetime
from pathlib import Path


def save_returns(books, log_name="returns.log", day_label=None):
    if day_label is None:
        day_label = datetime.now().strftime("%Y-%m-%d")

    with open(log_name, "a", encoding="utf-8") as log:
        log.write(f"\nDate: {day_label}\n")
        for book in books:
            log.write(book.rstrip() + "\n")


def process(day_file, log_name="returns.log",
            error_log="returns_errors.log"):

    path = Path(day_file)

    try:
        with path.open("r", encoding="utf-8") as file:
            books = [line.strip() for line in file if line.strip()]

        save_returns(books, log_name, path.name)

        print(f"Saved {len(books)} returned-book record(s) from {path.name}")

    except FileNotFoundError as error:
        message = f"{path}: file not found: {error}"
        with open(error_log, "a", encoding="utf-8") as log:
            log.write(message + "\n")
        print(message)

    except PermissionError as error:
        message = f"{path}: permission denied: {error}"
        with open(error_log, "a", encoding="utf-8") as log:
            log.write(message + "\n")
        print(message)

    except UnicodeDecodeError as error:
        message = f"{path}: invalid encoding: {error}"
        with open(error_log, "a", encoding="utf-8") as log:
            log.write(message + "\n")
        print(message)

    finally:
        print(f"Finished attempt for {path}")


if __name__ == "__main__":
    process("day1.txt")
    process("day2.txt")
    process("day3.txt")

